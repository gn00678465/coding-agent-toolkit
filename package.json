{
  "name": "coding-agent-toolkit",
  "version": "0.7.0",
  "private": true,
  "description": "Pi package entry for the coding-agent-toolkit skills plugin. Install with: pi install git:github.com/gn00678465/coding-agent-toolkit",
  "license": "MIT",
  "repository": "https://github.com/gn00678465/coding-agent-toolkit",
  "pi": {
    "extensions": [
      "./pi/extensions/upstream-skills.ts"
    ],
    "skills": [
      "./plugins/skills/skills"
    ],
    "prompts": [
      "./plugins/skills/prompts/*.prompt.md"
    ],
    "subagents": {
      "agents": [
        "./plugins/skills/agents/impeccable-ui-designer.md"
      ]
    }
  }
}
